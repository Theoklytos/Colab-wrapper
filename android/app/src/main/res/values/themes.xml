<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme for Colab Wrapper — pure black for AMOLED.
        NoActionBar: we rely on the WebView's own navigation.
        windowTranslucentStatus/Navigation: allows content to draw behind system bars.
    -->
    <style name="Theme.ColabWrapper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#0A0A0A</item>
        <item name="colorOnPrimary">#F9AB00</item>
        <item name="colorSecondary">#F9AB00</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <!-- Edge-to-edge: status bar and nav bar are transparent -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
