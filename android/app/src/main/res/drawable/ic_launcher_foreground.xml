<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: notebook + play button icon
    This SVG is used as the foreground layer of Android adaptive icons.
    The background is ic_launcher_background.xml (Colab orange).
    Foreground content must fit within the 66dp safe zone (center 80%).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Notebook page (centered within safe zone: 22dp to 86dp = 64dp) -->
    <path
        android:fillColor="#000000"
        android:pathData="M32,28 L76,28 Q80,28 80,32 L80,80 Q80,84 76,84 L32,84 Q28,84 28,80 L28,32 Q28,28 32,28 Z"/>

    <!-- Lines on notebook -->
    <path
        android:fillColor="#333333"
        android:pathData="M36,42 L72,42 Q73,42 73,44 Q73,46 72,46 L36,46 Q35,46 35,44 Q35,42 36,42 Z"/>
    <path
        android:fillColor="#333333"
        android:pathData="M36,52 L62,52 Q63,52 63,54 Q63,56 62,56 L36,56 Q35,56 35,54 Q35,52 36,52 Z"/>
    <path
        android:fillColor="#333333"
        android:pathData="M36,62 L66,62 Q67,62 67,64 Q67,66 66,66 L36,66 Q35,66 35,64 Q35,62 36,62 Z"/>

    <!-- Run button circle (overlapping top-right of notebook) -->
    <path
        android:fillColor="#000000"
        android:pathData="M71,26 A12,12 0 1 1 71,26.01 Z"
        android:strokeWidth="0"/>
    <!-- Actually draw the circle properly -->
    <group>
        <clip-path android:pathData="M108,0 L108,108 L0,108 L0,0 Z"/>
        <path
            android:fillColor="#000000"
            android:pathData="M71,14 A12,12 0 0,1 83,26 A12,12 0 0,1 71,38 A12,12 0 0,1 59,26 A12,12 0 0,1 71,14 Z"/>
    </group>

    <!-- Play triangle inside run button -->
    <path
        android:fillColor="#F9AB00"
        android:pathData="M67,20 L67,32 L78,26 Z"/>

</vector>
